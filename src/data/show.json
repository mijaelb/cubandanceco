{
  "title": "Raíces Cubanas",
  "subtitle": "A 90-minute dance-theatre show in two parts",
  "poster": "/images/photos/raices-poster.webp",
  "lead": "Water, myth and legend run through Cuban identity. Many cultures meet on the island, and together they shape the character of its people: rebellious, joyful, musical and united.",
  "text": "Raíces Cubanas is presented by the Generación Abbilona Association and the International Company of Cuban Dances. The show follows the music and dance of African and Cuban origin from colonial times to today.",
  "parts": [
    {
      "label": "Part one",
      "title": "Raíces",
      "image": "/images/photos/stage-africa.webp",
      "text": "Raíces is about the Afro-Cuban religious world and its myths. It shows how the orishas and other African deities shaped Cuban culture, with choreographies for Elegguá, Ogún, Yemayá, Changó and Oyá, and a scene about the crossing of enslaved Africans to Cuba."
    },
    {
      "label": "Part two",
      "title": "La Cubanía",
      "image": "/images/photos/stage-timba.webp",
      "text": "La Cubanía covers the popular music and dances that developed from the birth of the Republic to today: danzón, mambo, cha-cha-chá, son, the street vendors' calls (pregones), rumba and carnival. It celebrates the mix of peoples and cultures that makes Cuba what it is."
    }
  ],
