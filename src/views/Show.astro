---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Video from '../components/Video.astro';
import site from '../data/site.json';
import show from '../data/show.json';
import PerformanceList from '../components/PerformanceList.astro';
import perf from '../data/performances.json';
import { link, upcoming } from '../lib/utils';
import { useT } from '../i18n';

const { lang } = Astro.props;
const t = useT(lang);
// Only the dates where Raíces Cubanas itself was performed (other shows live on the Performances page)
const mine = (list: any[]) => list.filter((p) => p.production === show.title);
const next = upcoming(mine(perf.upcoming));
const past = mine(perf.past);
const mail = site.links.bookingEmail || site.links.email;
const contact = mail ? `mailto:${mail}?subject=${encodeURIComponent('Booking Raíces Cubanas')}` : site.links.instagram;
const strip = ['stage-ship', 'stage-oshun', 'stage-masks'].map((n) => `/images/photos/${n}.webp`);
---
<Layout lang={lang} page="raices-cubanas" title="Raíces Cubanas" description={show.text} image="/images/photos/stage-africa.webp">
  <PageHero image="/images/photos/stage-ship.webp" eyebrow={t(show.subtitle)} title={show.title} text={t(show.lead)} />

  <section class="section paper">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">{t('The show')}</p>
        <h2 class="display">{t('From Africa to the Cuba of today')}</h2>
        <p>{t(show.text)}</p>
        <p>{t('The show is divided into two main parts.')}</p>
      </div>
      <div class="reveal">
        <Video src="/video/raices-intro.mp4" poster="/images/photos/raices-intro-poster.jpg" label={t('Play the intro')} />
      </div>
    </div>
  </section>

  {show.parts.map((p, i) => (
    <section class:list={['section', i % 2 ? 'cream' : 'dark']}>
      <div class:list={['wrap split', { flip: i % 2 }]}>
        <div class="part-img reveal"><Img src={p.image} alt={t(p.title)} sizes="(min-width: 900px) 50vw, 100vw" /></div>
        <div class="reveal">
          <p class="part-num display">0{i + 1}</p>
          <p class="eyebrow">{t(p.label)}</p>
          <h2 class="display huge">{t(p.title)}</h2>
          <p>{t(p.text)}</p>
        </div>
      </div>
    </section>
  ))}

  <div class="strip" aria-hidden="true">{strip.map((s) => <Img src={s} sizes="(min-width: 700px) 33vw, 100vw" />)}</div>

  <section class="section paper">
    <div class="wrap split split-top">
      <div class="reveal">
        <p class="eyebrow">{t('Raíces Cubanas on stage')}</p>
        <h2 class="display">{next.length ? t('Upcoming shows') : t('Next dates to be announced')}</h2>
        <PerformanceList items={next} lang={lang} tag={false} />
        <PerformanceList items={past} lang={lang} tag={false} past />
        <a class="link-arrow" href={link(lang, 'performances')}>{t('All our performances')}</a>
      </div>
      <aside class="note-card gold reveal">
        <p class="eyebrow">{t('Bookings')}</p>
        <h3 class="display">{t('Bring Raíces Cubanas to your stage')}</h3>
        <p>{t(show.bookingText)}</p>
        <a class="btn btn-dark" href={contact}>{t('Contact us')}</a>
        {mail && <p class="muted">{mail}</p>}
      </aside>
    </div>
  </section>
</Layout>
