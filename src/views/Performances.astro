---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import PerformanceList from '../components/PerformanceList.astro';
import site from '../data/site.json';
import show from '../data/show.json';
import perf from '../data/performances.json';
import { link, upcoming } from '../lib/utils';
import { useT } from '../i18n';

const { lang } = Astro.props;
const t = useT(lang);
const next = upcoming(perf.upcoming);
const mail = site.links.bookingEmail || site.links.email;
const contact = mail ? `mailto:${mail}?subject=${encodeURIComponent(t('Performance booking'))}` : site.links.instagram;
const places = [...new Set(perf.past.map((p) => p.city.split(',')[0]))];
---
<Layout lang={lang} page="performances" title="Performances" description={perf.intro} image="/images/photos/stage-timba.webp">
  <PageHero image="/images/photos/stage-timba.webp" eyebrow={t('Performances')} title={t('On stage across Europe')} text={t(perf.intro)}>
    <div class="actions"><a class="btn btn-gold" href="#booking">{t('Book a performance')}</a></div>
  </PageHero>

  <section class="section paper">
    <div class="wrap split split-top">
      <div class="reveal">
        <p class="eyebrow">{t('Upcoming')}</p>
        <h2 class="display">{next.length ? t('Upcoming performances') : t('New dates coming soon')}</h2>
        <PerformanceList items={next} lang={lang} />
        <p class="eyebrow">{t('Where we have performed')}</p>
        <div class="chips chips-dark">{places.map((c) => <span>{c}</span>)}</div>
      </div>
      <a class="feature reveal" href={link(lang, 'raices-cubanas')}>
        <Img src={show.poster} alt={show.title} sizes="(min-width: 900px) 40vw, 100vw" />
        <div>
          <p class="eyebrow">{t('Our big show')}</p>
          <h3 class="display">{show.title}</h3>
          <p>{t(show.lead)}</p>
          <span class="link-arrow">{t('About the show')}</span>
        </div>
      </a>
    </div>
  </section>

  <section class="section cream">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">{perf.past.length} {t('performances so far')}</p><h2 class="display">{t('Past performances')}</h2></div></div>
      <PerformanceList items={perf.past} lang={lang} past />
    </div>
  </section>

  <section class="section green" id="booking">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">{t('Bookings')}</p>
        <h2 class="display">{t('Book a performance')}</h2>
        <p>{t(perf.bookingText)}</p>
        <div class="actions">
          <a class="btn btn-gold" href={contact}>{t('Contact us')}</a>
          {site.links.instagram && <a class="btn btn-line" href={site.links.instagram} target="_blank" rel="noopener">Instagram</a>}
        </div>
        {mail && <p class="muted">{mail}</p>}
      </div>
      <div class="part-img reveal"><Img src="/images/photos/stage-finale.webp" alt="" sizes="(min-width: 900px) 50vw, 100vw" /></div>
    </div>
  </section>
</Layout>
