---
// Printable training brochure (5 story-size pages, like the Instagram brochures).
// Opened from the timetable editor, which passes the training via localStorage,
// so drafts can be exported before they are published.
import '@fontsource/anton';
import '@fontsource-variable/montserrat';
import site from '../../data/site.json';
import { url } from '../../lib/utils';
import QRCode from 'qrcode';
// QR code for the WhatsApp group, made at build time (the link is hard to type from an image)
const qr = site.links.whatsapp ? await QRCode.toString(site.links.whatsapp, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#060e0a', light: '#0000' } }) : '';
const v = Date.now().toString(36); // new on every build, so browsers load the latest admin
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'" />
  <title>ICCD training schedule</title>
  <link rel="icon" href={url('/images/logo.svg')} type="image/svg+xml" />
  <link rel="stylesheet" href={url('/admin/brochure.css') + '?v=' + v} />
</head>
<body data-logo={url('/images/logo.svg')} data-tickets={site.links.tickets} data-handle={site.instagramHandle} data-email={site.links.email} data-whatsapp={site.links.whatsapp} data-instagram={site.links.instagram}>
  <div class="toolbar">
    <div class="tb-title"><b id="tb-name">Training brochure</b><span id="tb-info">PDF with working links, or one image per page for Instagram and WhatsApp</span></div>
    <div class="tb-buttons">
      <button type="button" id="print">Download PDF</button>
      <button type="button" id="images" class="secondary">Download images</button>
    </div>
  </div>
  <main id="pages"></main>
  <template id="qr" set:html={qr} />
  <script src={url('/admin/brochure.js') + '?v=' + v} type="module" is:inline></script>
  <script>
    // Exports the pages exactly as shown: a PDF made of page pictures (links stay tappable),
    // or one 1080 × 1920 image per page (Instagram story size).
    // On phones the files go to the share sheet; on computers they are downloaded.
    import { toCanvas } from 'html-to-image';
    const W = 810, H = 1440; // page size on screen
    const pages = () => [...document.querySelectorAll<HTMLElement>('.page')];
    const name = () => document.body.dataset.file || 'ICCD-training-schedule';
    const shot = (page: HTMLElement, ratio: number) => toCanvas(page, { pixelRatio: ratio, cacheBust: false, skipAutoScale: true, style: { margin: '0', zoom: '1' } });
    const blob = (c: HTMLCanvasElement, type: string, q?: number) => new Promise<Blob>((ok, no) => c.toBlob((b) => (b ? ok(b) : no(new Error('empty image'))), type, q));

    async function deliver(files: File[]) {
      const touch = matchMedia('(pointer: coarse)').matches;
      if (touch && navigator.canShare?.({ files })) return navigator.share({ files, title: name() });
      for (const f of files) {
        const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(f), download: f.name });
        document.body.append(a); a.click(); a.remove();
        await new Promise((r) => setTimeout(r, 300));
      }
    }

    // Invisible text under the picture, line by line in the same place, so the PDF text
    // can be selected, copied and searched (like a scanned document with OCR).
    function textLayer(pdf: any, page: HTMLElement) {
      const box = page.getBoundingClientRect(), k = W / box.width;
      const walk = document.createTreeWalker(page, NodeFilter.SHOW_TEXT, {
        acceptNode: (n) => (n.textContent!.trim() && !n.parentElement!.closest('.pattern, svg') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT),
      });
      pdf.setFont('helvetica', 'normal');
      for (let n = walk.nextNode() as Text | null; n; n = walk.nextNode() as Text | null) {
        const cs = getComputedStyle(n.parentElement!);
        const upper = cs.textTransform === 'uppercase';
        // group the words of this text into the lines they are drawn on
        const lines: { text: string; l: number; r: number; t: number; b: number }[] = [];
        for (const m of n.textContent!.matchAll(/\S+/g)) {
          const rg = document.createRange(); rg.setStart(n, m.index!); rg.setEnd(n, m.index! + m[0].length);
          const r = rg.getClientRects()[0]; if (!r) continue;
          const last = lines.at(-1);
          if (last && Math.abs(last.t - r.top) < r.height / 2) { last.text += ' ' + m[0]; last.r = r.right; }
          else lines.push({ text: m[0], l: r.left, r: r.right, t: r.top, b: r.bottom });
        }
        for (const ln of lines) {
          // the PDF base font only knows Western European letters
          const text = (upper ? ln.text.toUpperCase() : ln.text).replace(/[^ -~ -ÿ–—‘’“”•…]/g, '').trim();
          if (!text) continue;
          const size = (parseFloat(cs.fontSize) * W) / page.offsetWidth; // font sizes are not affected by the preview zoom
          pdf.setFontSize(size * 0.75); // px → pt
          const w = pdf.getTextWidth(text);
          pdf.text(text, (ln.l - box.left) * k, (ln.t - box.top) * k + ((ln.b - ln.t) * k + size * 0.7) / 2, {
            renderingMode: 'invisible', baseline: 'alphabetic', horizontalScale: w ? ((ln.r - ln.l) * k) / w : 1,
          });
        }
      }
    }

    async function makePdf(step: (i: number, n: number) => void) {
      const { jsPDF } = await import('jspdf');
      const pdf = new jsPDF({ unit: 'px', format: [W, H], orientation: 'portrait', hotfixes: ['px_scaling'], compress: true });
      const list = pages();
      for (const [i, page] of list.entries()) {
        step(i, list.length);
        if (i) pdf.addPage([W, H], 'portrait');
        const canvas = await shot(page, 2); // sharp when zoomed in
        pdf.addImage(canvas.toDataURL('image/jpeg', 0.9), 'JPEG', 0, 0, W, H, undefined, 'FAST');
        textLayer(pdf, page);
        // keep the links: tickets, maps, WhatsApp, Instagram, email
        const box = page.getBoundingClientRect(), k = W / box.width;
        page.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
          const r = a.getBoundingClientRect();
          pdf.link((r.left - box.left) * k, (r.top - box.top) * k, r.width * k, r.height * k, { url: a.href });
        });
      }
      return new File([pdf.output('blob')], `${name()}.pdf`, { type: 'application/pdf' });
    }

    async function makeImages(step: (i: number, n: number) => void) {
      const list = pages(), files: File[] = [];
      for (const [i, page] of list.entries()) {
        step(i, list.length);
        files.push(new File([await blob(await shot(page, 1080 / W), 'image/png')], `${name()}-${i + 1}.png`, { type: 'image/png' }));
      }
      return files;
    }

    function wire(id: string, make: (step: (i: number, n: number) => void) => Promise<File | File[]>) {
      const btn = document.getElementById(id) as HTMLButtonElement;
      btn.addEventListener('click', async () => {
        if (!pages().length) return;
        const label = btn.textContent;
        document.querySelectorAll<HTMLButtonElement>('.toolbar button').forEach((b) => (b.disabled = true));
        try {
          await document.fonts.ready;
          const out = await make((i, n) => (btn.textContent = `Preparing ${i + 1} / ${n}…`));
          await deliver(Array.isArray(out) ? out : [out]);
        } catch (e) {
          if ((e as Error).name !== 'AbortError') alert('Could not create the file: ' + (e as Error).message);
        } finally {
          document.querySelectorAll<HTMLButtonElement>('.toolbar button').forEach((b) => (b.disabled = false));
          btn.textContent = label;
        }
      });
    }
    wire('print', makePdf);
    wire('images', makeImages);
  </script>
</body>
</html>
