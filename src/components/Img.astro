---
import { url, srcset } from '../lib/utils';
import focus from '../lib/focus.json';
interface Props { src: string; alt?: string; sizes?: string; class?: string; eager?: boolean; style?: string }
const { src, alt = '', sizes = '100vw', eager = false, style = '', ...rest } = Astro.props;
// Keep faces in frame when the image is cropped (focus points come from scripts/focus.py)
const pos = (focus as Record<string, string>)[src];
---
<img src={url(src)} srcset={srcset(src)} sizes={sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} style={(pos ? `object-position:${pos};` : '') + style || undefined} {...rest} />
