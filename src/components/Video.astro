---
import { url } from '../lib/utils';
interface Props { src: string; poster: string; label: string }
const { src, poster, label } = Astro.props;
---
<div class="video">
  <video src={url(src)} poster={url(poster)} preload="none" playsinline></video>
  <button class="video-play" data-play aria-label={label}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
    <span>{label}</span>
  </button>
</div>
